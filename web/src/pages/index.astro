---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ElenaSection from '../components/ElenaSection.astro';
import SectionReveal from '../components/SectionReveal.astro';
import ProcessStep from '../components/ProcessStep.astro';
import CTAButton from '../components/CTAButton.astro';
import EmailCapture from '../components/EmailCapture.astro';
import CalendlyModal from '../components/CalendlyModal.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ReturnVisitorBanner from '../components/ReturnVisitorBanner.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import FaqSection from '../components/FaqSection.astro';
import HomepageCarousel from '../components/HomepageCarousel.astro';
import CircuitCarousel from '../components/CircuitCarousel.astro';
import ConceptQuote from '../components/ConceptQuote.astro';
import conceptPhoto from '../assets/images/destinations/gallery/west-coast/wc-3.webp';
import heroPoster from '../assets/images/hero-poster.webp';
import heroLogo from '../assets/images/logo-white.webp';
import elenaPhoto from '../assets/images/elena.webp';
import carouselAntelope from '../assets/homepage-carousel/FullSizeRender.jpg';
import carouselLA from '../assets/homepage-carousel/IMG_0226.jpg';
import carouselUsaRoadtrip from '../assets/homepage-carousel/IMG_0318.jpg';
import carouselBoston from '../assets/homepage-carousel/IMG_6042.jpg';
import carouselFloride from '../assets/homepage-carousel/floride.webp';
import carouselBowLake from '../assets/homepage-carousel/bow-lake.webp';
import carouselNewYork from '../assets/homepage-carousel/new-york.webp';
import carouselAlaska from '../assets/homepage-carousel/alaska-aurores.webp';
import carouselQuebec from '../assets/homepage-carousel/quebec.webp';
import { processSteps } from '../data/processSteps';
import { faqLd } from '../data/faq';
import { CIRCUITS_URL } from '../data/contact';

// Présentation d'Elena (« Hello ») : masquée depuis le passage aux circuits,
// le client achète d'abord le produit. Mettre `true` pour la réafficher.
const showElenaSection = false;

const optimizedPoster = await getImage({
  src: heroPoster,
  width: 1440,
  format: 'webp',
});

const carouselSlides = [
  {
    image: carouselAntelope,
    caption: 'Antelope Canyon — USA · Là où la lumière sculpte la roche',
  },
  {
    image: carouselFloride,
    caption: 'Floride — USA · Les pieds dans le sable, les yeux sur l’horizon',
  },
  {
    image: carouselLA,
    caption:
      'Los Angeles — Californie · Des palmiers et un lever de soleil doré',
  },
  {
    image: carouselBowLake,
    caption: 'Bow Lake — Canada · Un lac turquoise au pied des Rocheuses',
  },
  {
    image: carouselUsaRoadtrip,
    caption: 'USA — Road trip · L’aventure, à deux',
  },
  {
    image: carouselNewYork,
    caption: 'New York — USA · Chinatown et ses rues qui n’arrêtent jamais',
  },
  {
    image: carouselAlaska,
    caption: 'Alaska — USA · ça pourrait être toi sous les aurores boréales',
  },
  {
    image: carouselQuebec,
    caption: 'Québec — Canada · Le Château Frontenac entre les feuilles',
  },
  { image: carouselBoston, caption: 'Boston — La grandeur des buildings' },
];
---

<BaseLayout
  title="Slow Adventures — Circuits slow travel aux États-Unis et au Canada"
  description="Des circuits conçus par Elena pour mieux voyager aux États-Unis et au Canada. Tu choisis, on s’occupe du reste."
  heroPreloadImage={optimizedPoster.src}
  extraLd={faqLd}
>
  <header>
    <HeroSection
      posterSrc={heroPoster}
      videoSrc="/videos/hero.mp4"
      logoSrc={heroLogo}
      title="Slow Adventures"
      subtitle="Des circuits conçus par Elena pour mieux voyager aux États-Unis et au Canada. Tu choisis, on s’occupe du reste."
    />
  </header>
  <main id="main">
    <ReturnVisitorBanner />
    {
      showElenaSection && (
        <ElenaSection
          id="elena"
          imageSrc={elenaPhoto}
          imageAlt="Elena, créatrice de voyages immersifs en Amérique du Nord"
          title="Hello"
          description="Moi c’est Elena, et je suis une véritable voyageuse dans l’âme. Tombée amoureuse de l’Amérique du Nord, j’ai créé SlowAdventures pour partager les voyages qui me font rêver. Chaque circuit, je l’ai imaginé et construit avec soin, dans l’esprit du slow travel : des itinéraires pensés avec du sens, des hébergements choisis, et des expériences qui te connectent vraiment à l’âme des lieux. Pas besoin de tout organiser : tu choisis ton rêve, on s’occupe du reste, et tu pars l’esprit libre. Alors, plutôt team USA ou Canada ?"
          ctaHref={CIRCUITS_URL}
          ctaText="Découvre les circuits"
          ctaCalendly={false}
        />
      )
    }
    <ConceptQuote
      imageSrc={conceptPhoto}
      imageAlt="Les cheminées de fées orange de Bryce Canyon sous un ciel nuageux"
      imagePosition="center 70%"
      quote="Ici, le silence et l’immensité valent tous les itinéraires du monde."
      ctaText="C’est quoi le slow travel ?"
      ctaHref="/philosophie/"
    />
    <CircuitCarousel />
    <section
      id="processus"
      aria-labelledby="heading-processus"
      class="bg-creme sa-section-padding"
    >
      <div class="max-w-5xl mx-auto">
        <h2
          id="heading-processus"
          class="font-serif text-3xl md:text-4xl text-warm-black text-center mb-12"
        >
          Comment ton rêve prend vie
        </h2>
        <ol
          id="process-list"
          class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 list-none p-0"
        >
          {
            processSteps.map((step) => (
              <ProcessStep
                number={step.number}
                title={step.title}
                description={step.description}
                icon={step.icon}
                links={step.links}
              />
            ))
          }
        </ol>
      </div>
    </section>
    <!-- Section témoignages cachée temporairement
    <section
      id="temoignages"
      aria-labelledby="heading-temoignages"
      class="relative min-h-[70vh] overflow-hidden"
    >
      <Image
        src={testimonialsBg}
        alt=""
        widths={[768, 1440, 2880]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-ambre/60"></div>
      <div class="relative z-10 sa-section-padding max-w-5xl mx-auto">
        <h2
          id="heading-temoignages"
          class="font-serif text-3xl md:text-4xl text-white text-center mb-12"
        >
          Ils ont vécu SlowAdventures
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
          {
            testimonials.map((t) => (
              <SectionReveal animation="fade-up">
                <TestimonialCard
                  quote={t.quote}
                  name={t.name}
                  tripContext={t.tripContext}
                />
              </SectionReveal>
            ))
          }
        </div>
        <div class="text-center mt-12">
          <CTAButton
            href={import.meta.env.PUBLIC_CALENDLY_URL}
            variant="solid"
            size="small"
            text="Confie-moi ton prochain rêve"
            subtext=""
            desktopOnly={true}
          />
        </div>
      </div>
    </section>
    -->
    <section
      id="avantages"
      aria-labelledby="heading-avantages"
      class="bg-creme sa-section-padding"
    >
      <div class="max-w-3xl mx-auto">
        <SectionReveal animation="fade-up">
          <h2
            id="heading-avantages"
            class="font-serif text-3xl md:text-4xl text-warm-black text-center mb-16 md:mb-20"
          >
            Ce que Slow Adventures change (vraiment) pour toi
          </h2>
        </SectionReveal>
        <ul id="avantages-list" class="space-y-8 md:space-y-10 list-none p-0">
          <li
            class="avantage-item flex items-center gap-5 md:gap-6"
            data-avantage
          >
            <span
              class="avantage-marker shrink-0 text-xl leading-none opacity-0 scale-75"
              >✦</span
            >
            <p
              class="font-sans text-lg md:text-xl font-semibold text-warm-black/20 transition-none"
            >
              Des circuits imaginés par une passionnée, pas par un algorithme
            </p>
          </li>
          <li
            class="avantage-item flex items-center gap-5 md:gap-6"
            data-avantage
          >
            <span
              class="avantage-marker shrink-0 text-xl leading-none opacity-0 scale-75"
              >✦</span
            >
            <p
              class="font-sans text-lg md:text-xl font-semibold text-warm-black/20 transition-none"
            >
              Zéro organisation, zéro charge mentale
            </p>
          </li>
          <li
            class="avantage-item flex items-center gap-5 md:gap-6"
            data-avantage
          >
            <span
              class="avantage-marker shrink-0 text-xl leading-none opacity-0 scale-75"
              >✦</span
            >
            <p
              class="font-sans text-lg md:text-xl font-semibold text-warm-black/20 transition-none"
            >
              Réservations, paiement et assistance gérés par une agence
              partenaire
            </p>
          </li>
          <li
            class="avantage-item flex items-center gap-5 md:gap-6"
            data-avantage
          >
            <span
              class="avantage-marker shrink-0 text-xl leading-none opacity-0 scale-75"
              >✦</span
            >
            <p
              class="font-sans text-lg md:text-xl font-semibold text-warm-black/20 transition-none"
            >
              Un voyage clés en main qui garde sa part d’aventure
            </p>
          </li>
        </ul>
      </div>
    </section>
    <script>
      import { gsap } from '../lib/gsap';

      /*
       * ── Shared scroll conventions ──
       *   scrub: 1.2   (smooth, unhurried feel)
       *   trigger start: top 80%
       *   ease entrances: power2.out
       */

      /* ── Avantages: text lights up terracotta ── */
      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        const items = document.querySelectorAll('[data-avantage]');
        const list = document.getElementById('avantages-list');
        if (!items.length || !list) return;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: list,
            start: 'top 80%',
            end: 'bottom 50%',
            scrub: 1.2,
          },
        });

        items.forEach((item, i) => {
          const marker = item.querySelector('.avantage-marker');
          const text = item.querySelector('p');
          const pos = i * 0.8;

          tl.fromTo(
            text,
            { color: 'rgba(44, 40, 37, 0.15)' },
            { color: '#a65330', duration: 0.6, ease: 'power2.out' },
            pos
          );
          tl.fromTo(
            marker,
            { opacity: 0, scale: 0.5 },
            { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(2)' },
            pos + 0.15
          );
        });

        return () => {
          tl.kill();
        };
      });

      /* Reduced motion: avantages */
      gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
        document.querySelectorAll('[data-avantage]').forEach((item) => {
          const marker = item.querySelector('.avantage-marker') as HTMLElement;
          const text = item.querySelector('p') as HTMLElement;
          if (marker) {
            marker.style.opacity = '1';
            marker.style.transform = 'scale(1)';
          }
          if (text) text.style.color = '#a65330';
        });
      });

      /* ── Process steps: appear row by row (steps side by side appear
       *    together), title flashes terracotta ── */
      gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
        const steps = document.querySelectorAll('[data-process-step]');
        const processList = document.getElementById('process-list');
        if (!steps.length || !processList) return;

        gsap.set(steps, { opacity: 0, y: 30 });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: processList,
            start: 'top 80%',
            end: 'bottom 70%',
            scrub: 1.2,
          },
        });

        // Group steps by visual row (2 per row on desktop, 1 on mobile)
        // so that steps on the same line appear at the same time.
        const rowTops = [
          ...new Set(
            Array.from(steps, (step) => (step as HTMLElement).offsetTop)
          ),
        ].sort((a, b) => a - b);

        steps.forEach((step) => {
          const title = step.querySelector('.process-step__title');
          const row = rowTops.indexOf((step as HTMLElement).offsetTop);
          const pos = row * 1.8;

          tl.to(
            step,
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power2.out',
            },
            pos
          );

          if (title) {
            tl.fromTo(
              title,
              { color: '#2c2825' },
              { color: '#a65330', duration: 0.6, ease: 'power2.out' },
              pos
            );
            tl.to(
              title,
              { color: '#2c2825', duration: 0.6, ease: 'power2.inOut' },
              pos + 1.2
            );
          }
        });

        return () => {
          tl.kill();
        };
      });

      /* Reduced motion: process */
      gsap.matchMedia().add('(prefers-reduced-motion: reduce)', () => {
        gsap.set('[data-process-step]', { opacity: 1, y: 0 });
      });
    </script>
    <SectionReveal animation="fade-in">
      <HomepageCarousel slides={carouselSlides} />
    </SectionReveal>
    <section
      id="cta-final"
      aria-labelledby="heading-cta-final"
      class="bg-warm-black sa-section-padding"
    >
      <div class="max-w-3xl mx-auto text-center">
        <SectionReveal animation="scale-in">
          <h2
            id="heading-cta-final"
            class="font-serif text-3xl md:text-4xl lg:text-5xl text-white mb-8"
          >
            Ton prochain rêve commence ici
          </h2>
          <CTAButton
            href={CIRCUITS_URL}
            calendly={false}
            variant="solid"
            size="default"
            text="Choisis ton circuit"
            subtext="Tout est déjà pensé pour toi, il ne te reste qu’à choisir."
          />
        </SectionReveal>
      </div>
    </section>
    <SectionReveal animation="fade-in">
      <EmailCapture />
    </SectionReveal>
    <FaqSection />
    <div class="bg-creme text-center pb-16 md:pb-24 px-6">
      <CTAButton
        href={CIRCUITS_URL}
        calendly={false}
        variant="solid"
        size="small"
        text="Découvre les circuits"
        subtext=""
      />
    </div>
  </main>
  <CalendlyModal />
  <StickyMobileCTA />
  <ScrollProgress />
</BaseLayout>
