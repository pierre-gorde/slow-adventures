---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DestinationCard from '../../components/DestinationCard.astro';
import CTAButton from '../../components/CTAButton.astro';
import CalendlyModal from '../../components/CalendlyModal.astro';
import SectionReveal from '../../components/SectionReveal.astro';
import shuffleIcon from '../../assets/images/shuffle-icon.png';
import destPoster from '../../assets/images/destinations-hero-poster.webp';

const allDestinations = await getCollection('destinations');
const destinations = allDestinations.filter((d) => !d.data.draft);
const sorted = [...destinations].sort((a, b) => a.data.order - b.data.order);

const allSlugs = sorted.map((d) => d.slug);

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Toutes les destinations — Slow Adventures',
  description: `Découvre les destinations d'Amérique du Nord proposées par Slow Adventures.`,
  url: Astro.url.toString(),
};
---

<BaseLayout
  title="Ton aventure t'attend ici — Slow Adventures"
  description="Plutôt Canada, USA ou Alaska ? Chaque voyage est une immersion pensée pour toi. Découvre les destinations d'Amérique du Nord de Slow Adventures."
  extraLd={collectionLd}
>
  <main id="main">
    <!-- ═══════════════════════════════════════════════
         MINI-HERO
    ═══════════════════════════════════════════════ -->
    <section
      class="dest-listing-hero relative overflow-hidden"
      aria-label="En-tête destinations"
    >
      <Image
        src={destPoster}
        alt="Paysage d'Amérique du Nord"
        class="dest-listing-hero__poster"
        widths={[768, 1440]}
        sizes="100vw"
        loading="eager"
        decoding="async"
      />
      <video
        class="dest-listing-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/videos/destinations-hero.mp4" type="video/mp4" />
      </video>
      <div class="dest-listing-hero__overlay" aria-hidden="true"></div>
      <div class="max-w-4xl mx-auto text-center px-6 relative z-10">
        <p
          class="font-sans text-white/60 text-xs uppercase tracking-[0.25em] mb-4"
        >
          Slow Adventures
        </p>
        <h1
          class="font-serif text-4xl md:text-5xl lg:text-6xl text-white leading-tight mb-3"
        >
          Ton aventure t'attend ici
        </h1>
        <p
          class="font-sans text-white/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-10"
        >
          Plutôt Canada, USA ou Alaska ? Chaque voyage est une immersion pensée
          pour toi.
        </p>

        <!-- Search + Shuffle -->
        <div class="flex items-center gap-3 max-w-lg mx-auto">
          <div class="relative flex-1">
            <svg
              class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-warm-black/30 pointer-events-none"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              type="text"
              id="dest-page-search"
              class="w-full h-12 pl-12 pr-4 rounded-full bg-white shadow-sm border border-warm-black/8 font-sans text-base text-warm-black placeholder:text-warm-black/35 outline-none focus:ring-2 focus:ring-terracotta/30 focus:border-terracotta/30"
              placeholder="Rechercher un pays..."
              autocomplete="off"
            />
          </div>
          <button
            type="button"
            id="shuffle-btn"
            class="shuffle-btn shrink-0 flex items-center gap-2 h-12 px-5 rounded-full bg-terracotta text-white font-sans text-sm shadow-sm hover:bg-terracotta-dark transition-colors cursor-pointer"
            data-slugs={JSON.stringify(allSlugs)}
            aria-label="Destination aléatoire"
          >
            <Image
              src={shuffleIcon}
              alt=""
              width={20}
              height={20}
              class="w-5 h-5 shuffle-icon"
              aria-hidden="true"
            />
            <span class="hidden sm:inline">Choisis pour moi</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         DESTINATION GRID
    ═══════════════════════════════════════════════ -->
    <section class="bg-creme" aria-label="Liste des destinations">
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-8 md:py-12">
        <div id="dest-list-container">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
            {
              sorted.map((d) => (
                <DestinationCard
                  imageSrc={d.data.image}
                  imageAlt={`Paysage de ${d.data.country}`}
                  country={d.data.country}
                  description={d.data.description}
                  href={`/destinations/${d.slug}/`}
                  featured={d.data.featured}
                  slug={d.slug}
                  keywords={d.data.keywords ?? []}
                  overlayColor={d.data.overlayColor}
                />
              ))
            }
          </div>
          <p
            id="dest-page-no-result"
            class="hidden font-sans text-warm-black/40 text-center py-12"
          >
            Aucune destination trouvée
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         CTA SECTION
    ═══════════════════════════════════════════════ -->
    <section
      class="dest-cta-band sa-section-padding text-center"
      aria-labelledby="dest-listing-cta-heading"
    >
      <SectionReveal animation="scale-in">
        <div class="max-w-2xl mx-auto">
          <p
            class="font-sans text-white/70 text-xs uppercase tracking-[0.2em] mb-5"
          >
            Travel Planning sur mesure
          </p>
          <h2
            id="dest-listing-cta-heading"
            class="font-serif text-3xl md:text-4xl text-white mb-5"
          >
            Une destination te fait rêver ?
          </h2>
          <p class="font-sans text-white/85 text-lg mb-10 leading-relaxed">
            Dis-moi tes envies, tes contraintes, tes rêves — je m'occupe du
            reste.
          </p>
          <CTAButton
            href={import.meta.env.PUBLIC_CALENDLY_URL}
            variant="outline"
            text="Confie-moi ton prochain rêve"
            subtext="30 min, gratuit, sans engagement"
          />
        </div>
      </SectionReveal>
    </section>

    <!-- ═══════════════════════════════════════════════
         BACK LINK
    ═══════════════════════════════════════════════ -->
    <div class="text-center py-8 bg-creme">
      <a
        href="/"
        aria-label="Retour à l'accueil"
        class="inline-flex items-center gap-2 font-sans text-warm-black/60 hover:text-terracotta transition-colors text-sm"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 12H5M5 12l7 7M5 12l7-7"></path>
        </svg>
        Retour à l'accueil
      </a>
    </div>
  </main>
  <CalendlyModal />
</BaseLayout>

<style>
  /* Hero */
  .dest-listing-hero {
    padding: 8rem 1.5rem 3rem;
  }

  @media (min-width: 768px) {
    .dest-listing-hero {
      padding: 10rem 3rem 4rem;
    }
  }

  .dest-listing-hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .dest-listing-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0;
    transition: opacity 1s ease-in-out;
  }

  .dest-listing-hero__video.is-playing {
    opacity: 1;
  }

  .dest-listing-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.35) 60%,
      rgba(0, 0, 0, 0.6) 100%
    );
  }

  /* CTA band */
  .dest-cta-band {
    background: linear-gradient(
      135deg,
      var(--color-terracotta) 0%,
      var(--color-ambre) 60%,
      color-mix(in srgb, var(--color-ambre) 70%, var(--color-sauge)) 100%
    );
  }

  /* Shuffle button */
  .shuffle-btn:active .shuffle-icon {
    animation: spin-shuffle 0.5s ease;
  }

  @keyframes spin-shuffle {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Card flash */
  :global(.dest-mini--flash) {
    animation: card-flash 1.2s ease;
  }

  @keyframes card-flash {
    0% {
      box-shadow: 0 0 0 0
        color-mix(in srgb, var(--color-terracotta) 50%, transparent);
    }
    30% {
      box-shadow: 0 0 0 4px
        color-mix(in srgb, var(--color-terracotta) 30%, transparent);
    }
    100% {
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.dest-mini--flash),
    .shuffle-btn:active .shuffle-icon {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from '../../lib/gsap';

  // ── Video autoplay (same pattern as homepage HeroSection) ──
  (function initDestVideo() {
    const video = document.querySelector<HTMLVideoElement>(
      '.dest-listing-hero__video'
    );
    if (!video) return;

    const saveData =
      (navigator as unknown as { connection?: { saveData?: boolean } })
        .connection?.saveData === true;
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    if (saveData || reducedMotion) {
      video.remove();
      return;
    }

    video
      .play()
      .then(() => {
        video.classList.add('is-playing');
      })
      .catch(() => {});

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState !== 'visible') return;
      if (!video.paused) return;
      video
        .play()
        .then(() => {
          video.classList.add('is-playing');
        })
        .catch(() => {});
    });
  })();

  // ── Stagger animation on cards ──
  const allCards = document.querySelectorAll<HTMLElement>('.dest-card');
  if (allCards.length > 0) {
    gsap.set(allCards, { opacity: 0, y: 30 });
    gsap.to(allCards, {
      opacity: 1,
      y: 0,
      duration: 0.5,
      stagger: 0.04,
      ease: 'power2.out',
      delay: 0.5,
    });
  }

  // ── Search filter ──
  const searchInput = document.getElementById(
    'dest-page-search'
  ) as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('.dest-card');
  const noResult = document.getElementById('dest-page-no-result');

  const normalize = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .trim();

  function applyFilters() {
    const query = normalize(searchInput?.value ?? '');
    let visibleCount = 0;
    const toShow: HTMLElement[] = [];
    const toHide: HTMLElement[] = [];

    cards.forEach((card) => {
      const country = normalize(card.dataset.country ?? '');
      const show = !query || country.includes(query);
      if (show) {
        toShow.push(card);
        visibleCount++;
      } else {
        toHide.push(card);
      }
    });

    gsap.to(toHide, {
      opacity: 0,
      scale: 0.95,
      duration: 0.2,
      stagger: 0.02,
      onComplete: () => {
        toHide.forEach((c) => (c.style.display = 'none'));
        toShow.forEach((c) => (c.style.display = ''));
        gsap.fromTo(
          toShow,
          { opacity: 0, y: 15 },
          {
            opacity: 1,
            y: 0,
            duration: 0.35,
            stagger: 0.03,
            ease: 'power2.out',
            onComplete: () => ScrollTrigger.refresh(),
          }
        );
      },
    });

    if (noResult) {
      noResult.classList.toggle('hidden', visibleCount > 0);
    }
  }

  searchInput?.addEventListener('input', applyFilters);

  // ── Shuffle button ──
  const shuffleBtn = document.getElementById('shuffle-btn');
  if (shuffleBtn) {
    const slugs: string[] = JSON.parse(shuffleBtn.dataset.slugs ?? '[]');
    const icon = shuffleBtn.querySelector('.shuffle-icon');

    shuffleBtn.addEventListener('click', () => {
      if (slugs.length === 0) return;

      // Spin icon
      if (icon) {
        gsap.fromTo(
          icon,
          { rotation: 0 },
          { rotation: 720, duration: 0.6, ease: 'power2.inOut' }
        );
      }

      // Short delay for the animation feel, then redirect
      setTimeout(() => {
        const randomSlug = slugs[Math.floor(Math.random() * slugs.length)];
        window.location.href = `/destinations/${randomSlug}/`;
      }, 650);
    });
  }
</script>
