---
/**
 * Section « concept » de la page d'accueil : une grande photo, une phrase
 * sur le slow travel et un lien vers la page « Ma philosophie ».
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionReveal from './SectionReveal.astro';

interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  quote: string;
  ctaText: string;
  ctaHref: string;
  /** Partie de la photo à garder visible (CSS object-position). */
  imagePosition?: string;
}

const {
  imageSrc,
  imageAlt,
  quote,
  ctaText,
  ctaHref,
  imagePosition = 'center',
} = Astro.props;
---

<section
  id="concept"
  aria-labelledby="heading-concept"
  class="concept relative overflow-hidden flex items-center justify-center"
>
  <Image
    src={imageSrc}
    alt={imageAlt}
    widths={[768, 1440, 1920]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover"
    style={`object-position: ${imagePosition}`}
  />
  <div class="concept__overlay absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 py-24 text-center">
    <SectionReveal animation="fade-up">
      <h2 id="heading-concept" class="sr-only">Notre façon de voyager</h2>
      <blockquote>
        <p
          class="concept__quote font-serif italic text-white text-2xl md:text-4xl lg:text-[2.75rem] leading-snug"
        >
          « {quote} »
        </p>
      </blockquote>
      <a
        href={ctaHref}
        class="inline-flex items-center gap-3 mt-10 font-sans text-base font-medium text-white bg-warm-black/30 backdrop-blur-sm border-2 border-white/90 hover:bg-white hover:text-warm-black px-6 py-3 rounded-full transition-colors duration-200 group"
      >
        {ctaText}
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </SectionReveal>
  </div>
</section>

<style>
  .concept {
    min-height: 70vh;
  }

  /* Voile sombre, plus marqué au centre derrière le texte, pour que la
     phrase reste lisible même sur une photo très claire. */
  .concept__overlay {
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 50%,
        rgba(44, 40, 37, 0.55) 0%,
        rgba(44, 40, 37, 0) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(44, 40, 37, 0.5) 0%,
        rgba(44, 40, 37, 0.6) 100%
      );
  }

  .concept__quote {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }
</style>
