---
import CircuitCard from './CircuitCard.astro';
import SectionReveal from './SectionReveal.astro';
import { circuits } from '../data/circuits';
import { CIRCUITS_URL } from '../data/contact';
---

<section
  id="circuits"
  aria-labelledby="heading-circuits"
  class="bg-creme sa-section-padding overflow-hidden"
>
  <SectionReveal animation="fade-up">
    <h2
      id="heading-circuits"
      class="font-serif text-3xl md:text-4xl text-warm-black text-center mb-10"
    >
      Ton circuit de rêve se trouve ici
    </h2>
  </SectionReveal>

  <ul
    class="circuit-track max-w-5xl mx-auto list-none p-0"
    aria-label="Nos circuits"
  >
    {
      circuits.map((circuit) => (
        <li class="circuit-track__item">
          <CircuitCard circuit={circuit} />
        </li>
      ))
    }
  </ul>

  <div class="text-center mt-10">
    <a
      href={CIRCUITS_URL}
      class="inline-flex items-center gap-3 font-sans text-base font-medium text-terracotta hover:text-white border-2 border-terracotta hover:bg-terracotta px-6 py-3 rounded-full transition-all duration-200 group"
    >
      Voir tous les circuits
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* Mobile : défilement horizontal au doigt. Desktop : côte à côte. */
  .circuit-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    padding-bottom: 0.5rem;
  }

  .circuit-track::-webkit-scrollbar {
    display: none;
  }

  .circuit-track__item {
    flex: 0 0 85%;
    scroll-snap-align: center;
  }

  @media (min-width: 768px) {
    .circuit-track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
      overflow: visible;
      margin-inline: auto;
      padding-inline: 0;
    }
  }
</style>
