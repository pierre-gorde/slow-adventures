---
/**
 * Section « concept » de la page d'accueil : une grande photo, une phrase
 * sur le slow travel et un lien vers la page « Ma philosophie ».
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionReveal from './SectionReveal.astro';

interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  quote: string;
  ctaText: string;
  ctaHref: string;
}

const { imageSrc, imageAlt, quote, ctaText, ctaHref } = Astro.props;
---

<section
  id="concept"
  aria-labelledby="heading-concept"
  class="concept relative overflow-hidden flex items-center justify-center"
>
  <Image
    src={imageSrc}
    alt={imageAlt}
    widths={[768, 1440, 1920]}
    sizes="100vw"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="concept__overlay absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 py-24 text-center">
    <SectionReveal animation="fade-up">
      <h2 id="heading-concept" class="sr-only">Notre façon de voyager</h2>
      <blockquote>
        <p
          class="font-serif italic text-white text-2xl md:text-4xl lg:text-[2.75rem] leading-snug"
        >
          « {quote} »
        </p>
      </blockquote>
      <a
        href={ctaHref}
        class="inline-flex items-center gap-3 mt-10 font-sans text-base font-medium text-white border-2 border-white/80 hover:bg-white hover:text-warm-black px-6 py-3 rounded-full transition-colors duration-200 group"
      >
        {ctaText}
        <svg
          class="w-4 h-4 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </SectionReveal>
  </div>
</section>

<style>
  .concept {
    min-height: 70vh;
  }

  .concept__overlay {
    background: linear-gradient(
      to bottom,
      rgba(44, 40, 37, 0.45) 0%,
      rgba(44, 40, 37, 0.55) 100%
    );
  }
</style>
