# Brevo — Clé API (serveur uniquement, jamais exposée au navigateur)
BREVO_API_KEY=xkeysib-XXXXXXXX

# Calendly — URL publique de la page de booking
PUBLIC_CALENDLY_URL=https://calendly.com/elena-slow-adventures/30min

# Google Analytics 4 — Measurement ID
PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# URL du site (pour sitemap, canonical, OG)
SITE_URL=https://slowadventures.fr

# Rapport hebdo analytics (scripts/weekly-report/README.md)
# ID numérique de la propriété GA4 (Admin > Détails de la propriété), pas le G-…
GA4_PROPERTY_ID=123456789
# Clé JSON du compte de service, sur une ligne entre quotes simples
GA4_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"xxx@xxx.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nXXX\n-----END PRIVATE KEY-----\n","token_uri":"https://oauth2.googleapis.com/token"}'
REPORT_EMAIL_FROM=rapport@slowadventures.fr
REPORT_EMAIL_TO=elena@slowadventures.fr
# Optionnel : copie(s), séparées par des virgules
REPORT_EMAIL_CC=
