---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface SlideItem {
  image: ImageMetadata;
  caption: string;
}

interface Props {
  slides: SlideItem[];
}

const { slides } = Astro.props;

const optimized = await Promise.all(
  slides.map((s) => getImage({ src: s.image, width: 800, format: 'webp' })),
);
---

<section
  id="carrousel-voyageurs"
  aria-labelledby="heading-carrousel-voyageurs"
  class="bg-creme sa-section-padding overflow-hidden"
>
  <h2
    id="heading-carrousel-voyageurs"
    class="font-serif text-3xl md:text-4xl text-warm-black text-center mb-10"
  >
    Ça pourrait être toi 💚
  </h2>

  <div class="slider max-w-6xl mx-auto relative" id="homepage-slider">
    <!-- Track -->
    <div class="slider__viewport overflow-hidden">
      <div
        class="slider__track flex transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
        id="slider-track"
        data-total={slides.length}
      >
        {
          optimized.map((img, i) => (
            <div class="slider__slide shrink-0 px-2 md:px-3">
              <div class="overflow-hidden rounded-2xl">
                <img
                  src={img.src}
                  alt={slides[i].caption}
                  class="w-full aspect-[3/4] object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <p class="font-sans text-sm text-warm-black/50 italic text-center mt-3">
                {slides[i].caption}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Arrow left -->
    <button
      type="button"
      id="slider-prev"
      class="slider__arrow slider__arrow--prev absolute left-[-8px] md:left-[-24px] top-[40%] -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/90 shadow-md flex items-center justify-center text-warm-black/40 hover:text-terracotta hover:shadow-lg transition-all duration-200 cursor-pointer opacity-0 pointer-events-none z-10"
      aria-label="Photos précédentes"
    >
      <svg
        class="w-5 h-5 md:w-6 md:h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M15 18l-6-6 6-6" />
      </svg>
    </button>

    <!-- Arrow right -->
    <button
      type="button"
      id="slider-next"
      class="slider__arrow slider__arrow--next absolute right-[-8px] md:right-[-24px] top-[40%] -translate-y-1/2 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/90 shadow-md flex items-center justify-center text-warm-black/40 hover:text-terracotta hover:shadow-lg transition-all duration-200 cursor-pointer z-10"
      aria-label="Photos suivantes"
    >
      <svg
        class="w-5 h-5 md:w-6 md:h-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M9 18l6-6-6-6" />
      </svg>
    </button>
  </div>
</section>

<style>
  /* 3 visible on desktop, 2 on tablet, 1 on mobile */
  .slider__slide {
    width: calc(100% / 3);
  }

  @media (max-width: 767px) {
    .slider__slide {
      width: 80%;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .slider__slide {
      width: 50%;
    }
  }

  .slider__arrow--prev.is-visible,
  .slider__arrow--next.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider__track {
      transition: none;
    }
  }
</style>

<script>
  const track = document.getElementById('slider-track');
  const prevBtn = document.getElementById('slider-prev');
  const nextBtn = document.getElementById('slider-next');

  if (track && prevBtn && nextBtn) {
    const total = parseInt(track.dataset.total ?? '0', 10);
    let current = 0;

    function getVisible(): number {
      const w = window.innerWidth;
      if (w < 768) return 1;
      if (w < 1024) return 2;
      return 3;
    }

    function getSlideWidth(): number {
      const slide = track!.querySelector('.slider__slide') as HTMLElement | null;
      return slide ? slide.offsetWidth : 0;
    }

    function maxIndex(): number {
      return Math.max(0, total - getVisible());
    }

    function goTo(index: number) {
      const max = maxIndex();
      current = Math.max(0, Math.min(index, max));
      const slideW = getSlideWidth();
      track!.style.transform = `translateX(-${current * slideW}px)`;

      prevBtn!.classList.toggle('is-visible', current > 0);
      nextBtn!.classList.toggle('is-visible', current < max);
    }

    // Initial state
    function init() {
      goTo(current);
    }

    init();
    window.addEventListener('resize', () => goTo(current));

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    // Touch swipe
    let startX = 0;
    let deltaX = 0;
    let swiping = false;

    track.addEventListener(
      'touchstart',
      (e: TouchEvent) => {
        startX = e.touches[0].clientX;
        deltaX = 0;
        swiping = true;
        track!.style.transition = 'none';
      },
      { passive: true },
    );

    track.addEventListener(
      'touchmove',
      (e: TouchEvent) => {
        if (!swiping) return;
        deltaX = e.touches[0].clientX - startX;
        const slideW = getSlideWidth();
        const offset = -(current * slideW) + deltaX;
        track!.style.transform = `translateX(${offset}px)`;
      },
      { passive: true },
    );

    track.addEventListener('touchend', () => {
      if (!swiping) return;
      swiping = false;
      track!.style.transition = '';
      const threshold = getSlideWidth() * 0.2;
      if (deltaX < -threshold) {
        goTo(current + 1);
      } else if (deltaX > threshold) {
        goTo(current - 1);
      } else {
        goTo(current);
      }
    });

    // Keyboard
    document.getElementById('homepage-slider')?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });
  }
</script>
