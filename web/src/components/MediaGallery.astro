---
import { Image, getImage } from 'astro:assets';
import type { MediaItem } from '../types/media';

interface Props {
  items: MediaItem[];
  label: string;
}

const { items, label } = Astro.props;

/* Show up to 4 items in the mosaic grid, rest behind overlay */
const visibleCount = Math.min(items.length, 4);
const visibleItems = items.slice(0, visibleCount);
const totalCount = items.length;
const hiddenCount = totalCount - visibleCount;
const showTriggerBelow = hiddenCount === 0 && totalCount > 1;

/* Pre-optimize ALL images for the lightbox */
const allMedia: { type: 'image' | 'video'; src: string; poster?: string }[] =
  await Promise.all(
    items.map(async (item) => {
      if (item.type === 'image') {
        const opt = await getImage({
          src: item.src,
          width: 1440,
          format: 'webp',
        });
        return { type: 'image' as const, src: opt.src };
      }
      return { type: 'video' as const, src: item.src, poster: item.poster };
    }),
  );
---

<section
  class="media-gallery bg-white px-4 py-8 md:px-8 md:py-12"
  aria-label={label}
  data-media-items={JSON.stringify(allMedia)}
>
  <div class="max-w-5xl mx-auto">
    {/* ── Mosaic grid: 4 cols x 2 rows ── */}
    <div
      class="media-gallery__grid grid grid-cols-4 grid-rows-2 h-64 md:h-100 gap-1 rounded-xl overflow-hidden"
    >
      {
        visibleItems.map((item, i) => {
          const spanClass =
            i === 0
              ? 'col-span-2 row-span-2'
              : i === 1
                ? 'col-span-1 row-span-2'
                : 'col-span-1 row-span-1';

          return (
            <button
              type="button"
              class={`media-gallery__item relative overflow-hidden cursor-pointer group ${spanClass}`}
              data-gallery-index={i}
              aria-label={`${item.type === 'video' ? 'Vidéo' : 'Photo'} ${i + 1} — cliquer pour agrandir`}
            >
              {item.type === 'image' ? (
                <Image
                  src={item.src}
                  alt={`${label} — photo ${i + 1}`}
                  widths={[400, 800, 1200]}
                  sizes={i === 0 ? '50vw' : '25vw'}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <Fragment>
                  <img
                    src={item.poster}
                    alt={`${label} — vidéo ${i + 1}`}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center group-hover:bg-white transition-colors">
                      <svg
                        class="w-5 h-5 md:w-6 md:h-6 text-warm-black ml-0.5"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>
                </Fragment>
              )}
              {/* "Voir les X médias" overlay on last visible cell */}
              {i === visibleCount - 1 && hiddenCount > 0 && (
                <div class="absolute inset-0 bg-warm-black/45 flex items-center justify-center transition-colors group-hover:bg-warm-black/55">
                  <span class="font-sans text-white text-sm md:text-base font-medium tracking-wide">
                    Voir les {totalCount} photos
                  </span>
                </div>
              )}
            </button>
          );
        })
      }
    </div>

    {/* Button below grid when all items visible */}
    {
      showTriggerBelow && (
        <div class="text-center mt-5">
          <button
            type="button"
            class="media-gallery__trigger font-sans text-sm text-warm-black/60 hover:text-terracotta transition-colors inline-flex items-center gap-2"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="m21 15-5-5L5 21" />
            </svg>
            Voir les {totalCount} photos
          </button>
        </div>
      )
    }
  </div>
</section>

<!-- ═══ Fullscreen lightbox / slider (supports images + videos) ═══ -->
<div
  id="media-lightbox"
  class="fixed inset-0 z-50 bg-warm-black/95 hidden"
  role="dialog"
  aria-modal="true"
  aria-label={`Galerie ${label}`}
>
  <button
    type="button"
    id="mlb-close"
    class="absolute top-4 right-4 z-10 text-white/70 hover:text-white transition-colors p-2 cursor-pointer"
    aria-label="Fermer la galerie"
  >
    <svg
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M18 6 6 18M6 6l12 12" />
    </svg>
  </button>

  <div
    id="mlb-counter"
    class="absolute top-5 left-6 font-sans text-white/60 text-sm z-10"
    aria-live="polite"
  >
  </div>

  <button
    type="button"
    id="mlb-prev"
    class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-colors p-2 md:p-3 z-10 cursor-pointer"
    aria-label="Précédent"
  >
    <svg
      class="w-7 h-7 md:w-9 md:h-9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>

  <div
    id="mlb-track"
    class="absolute inset-0 flex items-center justify-center overflow-hidden touch-pan-y"
  >
    <img
      id="mlb-img"
      src=""
      alt=""
      class="mlb-media max-w-[92vw] max-h-[85vh] object-contain select-none"
      draggable="false"
    />
    <video
      id="mlb-video"
      class="mlb-media max-w-[92vw] max-h-[85vh] object-contain select-none hidden"
      controls
      playsinline
      preload="none"
    >
    </video>
  </div>

  <button
    type="button"
    id="mlb-next"
    class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white transition-colors p-2 md:p-3 z-10 cursor-pointer"
    aria-label="Suivant"
  >
    <svg
      class="w-7 h-7 md:w-9 md:h-9"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M9 18l6-6-6-6" />
    </svg>
  </button>
</div>

<style>
  .media-gallery__item:focus-visible {
    outline: 2px solid var(--color-terracotta);
    outline-offset: -2px;
  }

  .mlb-media {
    will-change: transform, opacity;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 0.3s ease-out, opacity 0.3s ease-out;
  }
</style>

<script>
  /* ── Media gallery lightbox — images + video ── */
  const gallerySection = document.querySelector<HTMLElement>('.media-gallery');
  const galleryTrigger = document.querySelector('.media-gallery__trigger');
  const lightbox = document.getElementById('media-lightbox');
  const lbImg = document.getElementById('mlb-img') as HTMLImageElement | null;
  const lbVideo = document.getElementById('mlb-video') as HTMLVideoElement | null;
  const lbCounter = document.getElementById('mlb-counter');
  const lbTrack = document.getElementById('mlb-track');
  const closeBtn = document.getElementById('mlb-close');
  const prevBtn = document.getElementById('mlb-prev');
  const nextBtn = document.getElementById('mlb-next');

  type MediaEntry = { type: 'image' | 'video'; src: string; poster?: string };
  const media: MediaEntry[] = JSON.parse(
    gallerySection?.dataset.mediaItems ?? '[]',
  );

  let current = 0;
  let isAnimating = false;

  function preloadAdjacent(index: number) {
    const prev = ((index - 1) % media.length + media.length) % media.length;
    const next = (index + 1) % media.length;
    [prev, next].forEach((i) => {
      if (media[i].type === 'image') {
        const img = new window.Image();
        img.src = media[i].src;
      }
    });
  }

  function show(index: number) {
    current = ((index % media.length) + media.length) % media.length;
    const entry = media[current];

    if (entry.type === 'video') {
      if (lbImg) lbImg.classList.add('hidden');
      if (lbVideo) {
        lbVideo.classList.remove('hidden');
        lbVideo.src = entry.src;
        lbVideo.poster = entry.poster ?? '';
        lbVideo.style.transform = 'translateX(0)';
        lbVideo.style.opacity = '1';
      }
    } else {
      if (lbVideo) {
        lbVideo.pause();
        lbVideo.removeAttribute('src');
        lbVideo.classList.add('hidden');
      }
      if (lbImg) {
        lbImg.classList.remove('hidden');
        lbImg.src = entry.src;
        lbImg.alt = `Photo ${current + 1}`;
        lbImg.style.transition = 'none';
        lbImg.style.transform = 'translateX(0)';
        lbImg.style.opacity = '1';
      }
    }

    if (lbCounter) {
      lbCounter.textContent = `${current + 1} / ${media.length}`;
    }
    preloadAdjacent(current);
  }

  function slideTo(index: number, direction: 'left' | 'right') {
    if (isAnimating) return;
    isAnimating = true;

    // Pause any playing video
    if (lbVideo) { lbVideo.pause(); }

    const activeEl = media[current].type === 'video' ? lbVideo : lbImg;
    const slideOut = direction === 'left' ? '-100%' : '100%';

    if (activeEl) {
      activeEl.style.transition =
        'transform 0.25s ease-in, opacity 0.2s ease-in';
      activeEl.style.transform = `translateX(${slideOut})`;
      activeEl.style.opacity = '0.3';
    }

    setTimeout(() => {
      show(index);
      const newEl = media[current].type === 'video' ? lbVideo : lbImg;
      const slideIn = direction === 'left' ? '60%' : '-60%';
      if (newEl) {
        newEl.style.transition = 'none';
        newEl.style.transform = `translateX(${slideIn})`;
        newEl.style.opacity = '0.3';
        void newEl.offsetWidth;
        newEl.style.transition =
          'transform 0.3s cubic-bezier(0.22,1,0.36,1), opacity 0.3s ease-out';
        newEl.style.transform = 'translateX(0)';
        newEl.style.opacity = '1';
      }
      setTimeout(() => { isAnimating = false; }, 300);
    }, 200);
  }

  function open(index: number) {
    show(index);
    if (lightbox) {
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function close() {
    if (lbVideo) { lbVideo.pause(); lbVideo.removeAttribute('src'); }
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  // Grid clicks
  document
    .querySelectorAll<HTMLElement>('.media-gallery [data-gallery-index]')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        open(parseInt(btn.dataset.galleryIndex ?? '0', 10));
      });
    });

  if (galleryTrigger) galleryTrigger.addEventListener('click', () => open(0));
  if (closeBtn) closeBtn.addEventListener('click', close);
  if (prevBtn) prevBtn.addEventListener('click', () => slideTo(current - 1, 'right'));
  if (nextBtn) nextBtn.addEventListener('click', () => slideTo(current + 1, 'left'));
  if (lbTrack) lbTrack.addEventListener('click', (e) => { if (e.target === lbTrack) close(); });

  /* Keyboard */
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') slideTo(current - 1, 'right');
    if (e.key === 'ArrowRight') slideTo(current + 1, 'left');
  });

  /* Touch swipe */
  let touchStartX = 0;
  let touchStartTime = 0;
  let touchDeltaX = 0;
  let isSwiping = false;

  if (lbTrack) {
    lbTrack.addEventListener('touchstart', (e: TouchEvent) => {
      if (isAnimating) return;
      touchStartX = e.touches[0].clientX;
      touchStartTime = Date.now();
      touchDeltaX = 0;
      isSwiping = true;
      const el = media[current].type === 'video' ? lbVideo : lbImg;
      if (el) el.style.transition = 'none';
    }, { passive: true });

    lbTrack.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isSwiping || isAnimating) return;
      touchDeltaX = e.touches[0].clientX - touchStartX;
      const el = media[current].type === 'video' ? lbVideo : lbImg;
      if (el) {
        const dampened = touchDeltaX * 0.85;
        const opacity = Math.max(0.4, 1 - Math.abs(dampened) / window.innerWidth);
        el.style.transform = `translateX(${dampened}px)`;
        el.style.opacity = String(opacity);
      }
    }, { passive: true });

    lbTrack.addEventListener('touchend', () => {
      if (!isSwiping || isAnimating) return;
      isSwiping = false;
      const elapsed = Date.now() - touchStartTime;
      const velocity = Math.abs(touchDeltaX) / elapsed;
      const threshold = 50;
      const fastSwipe = velocity > 0.3 && Math.abs(touchDeltaX) > 20;

      if (touchDeltaX < -threshold || (touchDeltaX < 0 && fastSwipe)) {
        slideTo(current + 1, 'left');
      } else if (touchDeltaX > threshold || (touchDeltaX > 0 && fastSwipe)) {
        slideTo(current - 1, 'right');
      } else {
        const el = media[current].type === 'video' ? lbVideo : lbImg;
        if (el) {
          el.style.transition = 'transform 0.3s cubic-bezier(0.22,1,0.36,1), opacity 0.3s ease-out';
          el.style.transform = 'translateX(0)';
          el.style.opacity = '1';
        }
      }
    });
  }
</script>
