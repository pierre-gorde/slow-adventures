---
interface Props {
  number: number;
  title: string;
  description: string;
  icon?: string;
  links?: { label: string; href: string; calendly?: boolean }[];
}

const { number, title, description, icon, links = [] } = Astro.props;

const escapeHtml = (t: string) =>
  t
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

// Construit en une seule chaîne pour éviter les espaces parasites autour des liens.
const linksHtml = links
  .map((link) => {
    const attrs = link.calendly
      ? 'data-calendly-trigger'
      : 'target="_blank" rel="noopener noreferrer"';
    return `<a href="${escapeHtml(link.href)}" ${attrs} class="text-terracotta underline underline-offset-4 hover:text-terracotta-dark">${escapeHtml(link.label)}</a>`;
  })
  .join(' ou ')
  .concat(links.length > 0 ? '.' : '');
---

<li
  class="flex flex-col items-center text-center md:items-start md:text-left"
  data-process-step
>
  <div class="flex items-center gap-3 mb-3">
    {
      icon && (
        <span
          class="w-8 h-8 text-terracotta"
          aria-hidden="true"
          set:html={icon}
        />
      )
    }
    <span class="text-terracotta font-serif text-4xl font-bold">{number}</span>
  </div>
  <h3 class="process-step__title font-serif text-xl text-warm-black mb-2">
    {title}
  </h3>
  <p class="font-sans text-warm-gray leading-relaxed whitespace-pre-line">
    <Fragment set:html={escapeHtml(description) + linksHtml} />
  </p>
</li>
